(ftf
  (header
    (version 2.0)
    (unit DBUNIT)
  )
  (TechnologyContainer
    (technology SamacSys_Footprint
      (footprintLayer
        (layer Top (type Conductive))
        (layer Inner (type Conductive))
        (layer Bottom (type Conductive))
        (layer Silk-Top (type Symbolmark))
        (layer Silk-Bottom (type Symbolmark))
        (layer Resist-Top (type Solderresist))
        (layer Resist-Bottom (type Solderresist))
        (layer MetalMask-Top (type Metalmask))
        (layer MetalMask-Bottom (type Metalmask))
        (layer CompArea-Top (type Comparea))
        (layer CompArea-Bottom (type Comparea))
        (layer Assembly-Top (type Undefined))
        (layer Assembly-Bottom (type Undefined))
        (layer Hole (type Hole))
      )
    )
  )
  (footprintContainer
    (commonParameters
      (dimensionParameters
        (arrowLength 100000)
        (arrowAngle 15.000000)
        (dotDiameter 100000)
        (textFrameOffset 100000)
        (arrowOffset 100000)
        (dimAssistOffset 100000)
        (dimLineWidth 10000)
        (drawTextFrame NO)
        (textFrameRange ALL)
        (textClip NO)
        (standard JIS)
      )
    )
    (padstackGroups
      (padstackGroup default)
    )
    (pads
      (pad c217.5
        (photo FLASH)
        (panelUse NO)
        (geometry
          (circle 108750
            (pt 0 0)
          )
        )
      )
    ); End of pads
    (padstacks
      (padstack c217.5h145
        (type PLATED)
        (throughMode THROUGH)
        (panelUse NO)
        (Hole (footLayer Hole)
          (geometry
            (circle 72500
              (pt 0 0)
            )
          )
        )
        (padSet (footLayer Top)
          (connect (pad c217.5))
          (noconnect (pad c217.5))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad c217.5))
          (noconnect (pad c217.5))
        )
        (padSet (footLayer Resist-Bottom)
          (connect (pad c217.5))
          (noconnect (pad c217.5))
        )
        (padSet (footLayer Inner)
          (clearance (pad c217.5))
          (connect (pad c217.5))
          (noconnect (pad c217.5))
        )
        (padSet (footLayer Bottom)
          (connect (pad c217.5))
          (noconnect (pad c217.5))
        )
      )
    ); End of padstacks
    (footprints
      (footprint "9288141"
        (polarity YES)
        (panelUse NO)
        (heelprint
          (layout
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -715600 60000
                        (width 20000)
                      )
                      (pt 884400 60000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 884400 60000
                        (width 20000)
                      )
                      (pt 884400 -60000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 884400 -60000
                        (width 20000)
                      )
                      (pt -715600 -60000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -715600 -60000
                        (width 20000)
                      )
                      (pt -715600 60000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer CompArea-Top)
              (area
                (geometry
                  (surface
                    (outlineWidth 0)
                    (fillWidth 0)
                    (fillAngle 0.000000)
                    (vertex
                    (pt 984400 208700)
                    (pt 984400 -208700)
                    (pt -984400 -208700)
                    (pt -984400 208700)
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -137600 60000
                        (width 10000)
                      )
                      (pt 884400 60000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 884400 60000
                        (width 10000)
                      )
                      (pt 884400 -60000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 884400 -60000
                        (width 10000)
                      )
                      (pt -137600 -60000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -645600 60000
                        (width 10000)
                      )
                      (pt -397600 60000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -645600 -60000
                        (width 10000)
                      )
                      (pt -397600 -60000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
           ); End of layout
         ); End of heelprint
         (toeprint
          (pin 1
            (pt -775600 0)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -775600 0)
                  (angle 90)
                  (padstackGroup default (padstack c217.5h145))
                )
              )
            )
          )
          (pin 2
            (pt -267600 0)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -267600 0)
                  (angle 90)
                  (padstackGroup default (padstack c217.5h145))
                )
              )
            )
          )
        ); End of toeprint
        (propertyS accurateShape 928814-1.stp)
      ); End of footprint
    ); End of footprints
  );  End of footprintContainer
); End of ftf

